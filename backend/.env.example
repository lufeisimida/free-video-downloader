# AI 大模型连接（OpenAI 兼容接口，适用于官方 API / 中转站）
# 也可在前端「模型配置」页面填写；页面保存的值优先于 .env
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key
LLM_MODEL=gpt-4o-mini

# 兼容旧变量名（未设置 LLM_* 时仍可生效）
# OPENAI_BASE_URL / OPENAI_API_KEY / OPENAI_MODEL
# DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY / DEEPSEEK_MODEL
# MX52_BASE_URL / MX52_API_KEY / MX52_MODEL

# 无平台字幕时使用本地 faster-whisper 进行语音转写
# 首次转写会自动下载模型；small 约 500MB，中文效果和速度较均衡
WHISPER_MODEL=small
# 纯 CPU 推荐 cpu + int8；NVIDIA CUDA 环境可改为 cuda + float16
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# 留空表示自动识别语言，也可以指定 zh / en / ja 等
WHISPER_LANGUAGE=
WHISPER_BEAM_SIZE=5
# Hugging Face 连接不稳定时可设置镜像地址，例如 https://hf-mirror.com
WHISPER_HF_ENDPOINT=

# 本地视频上传大小上限（字节），默认 2GB
MAX_LOCAL_UPLOAD_BYTES=2147483648

# 视频解析 Cookie（Netscape 格式 cookies.txt 路径）。
# 服务器 IP 常被 B 站等平台风控拦截（HTTP 412），提供真实浏览器 Cookie 可绕过。
# 用浏览器插件「Get cookies.txt」导出 bilibili.com 的 Cookie 后上传到服务器，填绝对路径。
# COOKIES_FILE=/app/backend/cookies.txt
# 平台字幕缓存有效期（秒），默认 30 天；设置为 0 表示永久保留
SUBTITLE_CACHE_TTL_SECONDS=2592000

# 开发/自用开关
# 是否开放用户注册。false 时保留注册代码，但接口和前端入口都会关闭
REGISTRATION_ENABLED=false
# 内置登录账号。服务启动时自动创建；修改密码后重启会自动同步
BUILTIN_ACCOUNT_EMAIL=admin@saveany.local
BUILTIN_ACCOUNT_PASSWORD=replace-with-a-strong-password
# true 表示关闭 AI 总结登录和次数限制；生产环境建议设为 false
DISABLE_SUMMARY_PAYWALL=false
# 填邮箱后，这些账号登录时显示为 VIP，且 AI 总结无限次。多个邮箱用英文逗号分隔
SUPERUSER_EMAILS=
# false 表示禁用 Stripe 支付接口
PAYMENT_ENABLED=true

# JWT 密钥（生产环境请使用强随机字符串）
JWT_SECRET=your-jwt-secret-change-in-production

# Stripe 支付配置
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID_MONTHLY=price_your_monthly_price_id

# 学习任务与模型路由
PIPELINE_MAX_CONCURRENCY=2
REMINDER_POLL_SECONDS=60
# 按任务覆盖默认模型连接；支持 QUIZ / COURSE_QA / DIAGNOSIS 等后缀
# LLM_QUIZ_BASE_URL=https://api.openai.com/v1
# LLM_QUIZ_API_KEY=
# LLM_QUIZ_MODEL=gpt-4o-mini
# 语义向量默认复用当前模型连接，也可单独配置
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
# true 时复用当前聊天模型连接；中转站不支持 /embeddings 时请保持 false 并单独配置
EMBEDDING_REUSE_LLM=false
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# 邮件提醒
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# 企业微信机器人提醒
WECOM_WEBHOOK_URL=

# 前端 URL（用于 Stripe 支付回跳）
FRONTEND_URL=http://localhost:5173
